{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "declaration": true,
    "inlineSourceMap": true,
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
